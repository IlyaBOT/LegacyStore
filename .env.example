POSTGRES_DB=legacystore
POSTGRES_USER=legacystore
POSTGRES_PASSWORD=legacystore_dev_password
DATABASE_URL=postgres://legacystore:legacystore_dev_password@postgres:5432/legacystore?sslmode=disable

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
ADMIN_WEB_BASE_URL=http://localhost:8081
ADMIN_WEB_PORT=8081
ADMIN_WEB_HTTPS_PORT=8443

# Enable only when the backend is reachable exclusively through a trusted reverse proxy
# which overwrites X-Forwarded-Proto. Never enable this on a directly exposed backend.
TRUST_PROXY_HEADERS=false

JWT_SECRET=change_me_in_production
SESSION_SECRET=change_me_in_production

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/data/storage
# Maximum uploaded artifact size in bytes. Default: 8 GiB.
MAX_UPLOAD_BYTES=8589934592

CATALOG_SIGNING_ENABLED=false
CATALOG_PUBLIC_KEY_PATH=
CATALOG_PRIVATE_KEY_PATH=

OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_TEAM_ID=
OAUTH_APPLE_KEY_ID=
OAUTH_APPLE_PRIVATE_KEY_PATH=
